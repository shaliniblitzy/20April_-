# =============================================================================
# Environment-variable contract for the Flask application scaffold.
# Copy this file to `.env` for local development; the `flask` CLI auto-loads it
# via python-dotenv when present.
#
# Per AAP §0.6.4 every `process.env.X` from the original Node.js server must be
# mirrored into this file (and into `app/config.py`) before functional parity
# can be claimed.
# =============================================================================

# Application entry point used by the `flask` CLI (matches `wsgi.py:app`).
FLASK_APP=wsgi:app

# Selects the Config class in `app/config.py::config_by_name`.
# Accepted values: development | production | testing
FLASK_CONFIG=development

# Used by Flask for session-cookie signing (ItsDangerous). NEVER commit a real
# secret; generate one per environment, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-me

# Bind address and port for the development server (`flask run`) and for the
# gunicorn `--bind` argument in production (`gunicorn -b ${HOST}:${PORT} wsgi:app`).
HOST=0.0.0.0
PORT=5000

# Root log level honoured by `app/logging_config.py`.
# Accepted values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
