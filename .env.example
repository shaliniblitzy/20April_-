# =============================================================================
# .env.example — Environment-variable contract template
#
# Anchored by:
#   - AAP §0.4.1  — transformation-table row for `.env.example`
#   - AAP §0.4.2  — configuration wiring (values consumed by `app/config.py`
#                   and `app/logging_config.py`)
#   - AAP §0.6.4  — configuration & environment parity (every `process.env.X`
#                   reference from the original Node.js server MUST be mirrored
#                   here AND added as a typed attribute in `app/config.py`)
#   - AAP §0.7.4  — open clarification questions (env-var inventory)
#
# Status: TEMPLATE.
#   Copy this file to `.env` and customise per machine / environment:
#       cp .env.example .env
#
# Source-control contract:
#   `.env` is GITIGNORED (see .gitignore Phase 6) and MUST NOT contain real
#   secrets in source control. This `.env.example` template IS committed and
#   is the single authoritative declaration of every variable the application
#   reads. Real secrets (production SECRET_KEY, database credentials, API
#   tokens, …) MUST be injected via the native process environment, a secret
#   manager (Vault, AWS Secrets Manager, etc.), or a per-environment `.env`
#   that is provisioned out-of-band — never via a committed file.
#
# Loading behaviour:
#   `python-dotenv` is loaded AUTOMATICALLY by the `flask` CLI when a `.env`
#   file is present in the working directory or any parent directory
#   [web:flask-docs:installation]. Production deployments under gunicorn use
#   the native process environment exported by the orchestrator (systemd,
#   Docker, Kubernetes, etc.) and do NOT rely on `.env` files.
#
# File-format rules (enforced by python-dotenv):
#   - One `KEY=value` per line, no spaces around `=`.
#   - Lines beginning with `#` are comments.
#   - Quotes are only required when the value contains whitespace or a `#`.
#   - Line endings MUST be LF (Unix); CRLF is not recommended.
#
# No source counterpart exists in the repository [tech-spec:§1.2]; every
# block below is authored from the AAP's stated contract.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask
# -----------------------------------------------------------------------------
# Application import string consumed by the `flask` CLI. Resolved as
# `from wsgi import app`; matches the `app = create_app()` binding established
# in `wsgi.py`. Used by `flask run`, `flask routes`, `flask shell`, etc.
FLASK_APP=wsgi:app

# Selects which Config subclass `app/config.py::config_by_name` loads inside
# `create_app()`. Accepted values: `development`, `production`, `testing`.
# Defaults to `development` in `create_app()` if the variable is unset.
FLASK_CONFIG=development


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Flask secret key used by ItsDangerous to sign session cookies and any other
# data passed through `flask.session` or `itsdangerous.URLSafeTimedSerializer`
# [web:flask-docs:installation]. MUST be replaced with a strong random value
# in every non-development environment. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real SECRET_KEY to source control — leave the literal
# placeholder `change-me` in this template and supply the real value via
# the deployment environment.
SECRET_KEY=change-me


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Bind host for the development server (`flask run -h $HOST`) and for the
# gunicorn `--bind ${HOST}:${PORT}` argument in production.
#   0.0.0.0   — listen on all network interfaces (typical for containers and
#               servers reachable from outside the host).
#   127.0.0.1 — loopback only (typical for local development behind a reverse
#               proxy or for security-sensitive single-host deployments).
HOST=0.0.0.0

# Bind port. `5000` is Flask's documented development default and is the
# value used by `flask run` when no `-p` flag is supplied.
PORT=5000


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Root log level honoured by `app/logging_config.py::configure_logging`.
# Standard `logging` module thresholds, ordered most-verbose to least:
#   DEBUG | INFO | WARNING | ERROR | CRITICAL
# Defaults to `INFO` if unset. Use `DEBUG` for local diagnostics, `WARNING`
# or higher for production noise reduction.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Application (port any process.env.X from the original Node.js server here)
# -----------------------------------------------------------------------------
# Reserved for variables introduced when the original Node.js server is ported
# into this Flask scaffold. Per AAP §0.6.4 and §0.7.2, EVERY `process.env.X`
# reference discovered in the Node source MUST be:
#   1. Added below as `X=<sensible-default-or-placeholder>` with a comment
#      explaining its purpose and accepted values.
#   2. Mirrored as a typed attribute on the appropriate Config class in
#      `app/config.py` so the application reads it via `current_app.config["X"]`
#      rather than directly via `os.environ`.
# This section is intentionally empty in the scaffold-only state because the
# Node.js source has not yet been supplied (see AAP §0.6.1, §0.7.4).
